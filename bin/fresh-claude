#!/usr/bin/env bash
set -euo pipefail
# Launch the fresh editor with the "claude" profile:
#   file tree + Artifacts column | editor + shell below | Claude Code right.
#
# Usage: fresh-claude [workspace-dir]
# Workspace resolution: argument > ~/.config/fresh-claude/workspace > $PWD.

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/fresh-claude/workspace"
dir="${1:-}"
if [[ -z "$dir" && -f "$config_file" ]]; then
	dir="$(<"$config_file")"
fi
dir="${dir:-$PWD}"
if [[ "$(cd "$dir" && pwd -P)" == "$(cd "$HOME" && pwd -P)" ]]; then
	echo "fresh-claude: refusing to launch in home directory — cd into a project or pass a workspace dir" >&2
	exit 1
fi
cd "$dir"

# Per-workspace tmux session name. The names used to be the fixed `fresh` /
# `fresh-shell`, and `new-session -A` on a fixed name made a second
# fresh-claude in another directory ATTACH to the first instance's sessions
# (mirrored terminals), while the stale-watcher C-c below killed the first
# instance's live watcher. Hashing the canonical workspace path keeps the
# wanted persistence — relaunching in the SAME dir reattaches that dir's
# sessions — while concurrent instances stay disjoint. Sanitized basename
# in front so `tmux ls` stays readable.
ws_base="$(basename "$(pwd -P)" | tr -cs 'a-zA-Z0-9' '-')"
ws_base="${ws_base%-}"
FRESH_TMUX_SESSION="fresh-${ws_base}-$(pwd -P | cksum | cut -d' ' -f1)"
export FRESH_TMUX_SESSION

# init.ts spawns Claude Code directly as the PTY child (no login shell), so
# hand it a full path — the PTY won't have your shell profile's PATH.
FRESH_CLAUDE_BIN="$(command -v claude || true)"
export FRESH_CLAUDE_BIN

# Same for tmux: the bottom shell runs inside tmux (raw-mode TUI) so mouse
# escape sequences that fresh leaks into the focused pane get parsed and
# dropped instead of echoed as garbage at the prompt. Empty if not installed —
# init.ts then falls back to a plain shell.
FRESH_TMUX_BIN="$(command -v tmux || true)"
export FRESH_TMUX_BIN

# The tmux session is persistent (-A): a relaunch in this dir reattaches a
# pane that may still be running the previous launch's watcher, with a stale
# queue path. Interrupt it server-side BEFORE fresh starts — no
# attached-client races. At an idle prompt the C-c is a no-op. `=` forces an
# exact-name match so the "-shell" session can never be prefix-matched.
if [[ -n "$FRESH_TMUX_BIN" ]] && "$FRESH_TMUX_BIN" has-session -t "=$FRESH_TMUX_SESSION" 2>/dev/null; then
	# send-keys needs a pane target: "=name" alone fails, "=name:" resolves
	# to the session's active pane.
	"$FRESH_TMUX_BIN" send-keys -t "=$FRESH_TMUX_SESSION:" C-c
fi
export FRESH_PROFILE=claude

# ── tmux shield ──────────────────────────────────────────────────────────
# fresh 0.4.x has a ~15ms ESC-grace race in its input parser (sinelaw/fresh
# #2793): a mouse escape sequence split across terminal reads with a >15ms
# gap — routine at the tail of a momentum scroll, when wheel events go
# sparse — is flushed as a lone ESC keypress and the remainder is TYPED
# INTO THE BUFFER ("[<65;60;10M" garbage) while the viewport snaps away.
# Running fresh inside a dedicated tmux absorbs this: tmux's parser waits
# escape-time (500ms) for sequence tails and re-emits complete sequences
# into fresh's pty. Own socket (-L) and own config (-f): the user's
# ~/.tmux.conf (escape-time 0, mouse on, status bar…) must not leak in —
# the shield has to stay invisible. prefix None + status off make it so.
# --no-restore: fresh otherwise restores the last session's workspace
# (splits, explorer state), overriding the layout init.ts builds.
if [[ -n "$FRESH_TMUX_BIN" ]]; then
	shield_conf="${XDG_CONFIG_HOME:-$HOME/.config}/fresh-claude/tmux-shield.conf"
	mkdir -p "$(dirname "$shield_conf")"
	cat > "$shield_conf" <<'EOF'
# Generated by fresh-claude at every launch — edits here are overwritten.
set -s escape-time 500
set -g status off
set -g prefix None
set -g default-terminal "tmux-256color"
set -as terminal-features ',*:RGB'
set -s set-clipboard on
set -g focus-events on
EOF
	# -e: a pre-existing shield server (concurrent instance in another
	# workspace) would otherwise hand this session the FIRST instance's
	# stale globals instead of ours. TMUX= : permit launching from inside
	# a regular tmux session — the shield lives on its own socket, so
	# this is not real nesting. Unique session name ($$): concurrent
	# instances must never attach to each other's editors.
	TMUX= exec "$FRESH_TMUX_BIN" -L fresh-claude-shield -f "$shield_conf" \
		new-session -s "editor-$$" \
		-e FRESH_PROFILE=claude \
		-e FRESH_CLAUDE_BIN="$FRESH_CLAUDE_BIN" \
		-e FRESH_TMUX_BIN="$FRESH_TMUX_BIN" \
		-e FRESH_TMUX_SESSION="$FRESH_TMUX_SESSION" \
		fresh --no-restore
fi
exec fresh --no-restore
